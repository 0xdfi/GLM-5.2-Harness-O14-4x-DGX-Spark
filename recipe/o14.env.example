# Required: a host/container-visible checkpoint directory.
MODEL_PATH=/models
HOST=0.0.0.0
PORT=8211

# Live O14 serving envelope.
SERVED_MODEL_NAME=glm-5.2
MAX_MODEL_LEN=399000
KV_CACHE_MEMORY_BYTES=12792889000
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=2048
LONG_PREFILL_TOKEN_THRESHOLD=2048
DECODE_PREFILL_TOKEN_BUDGET=256
IDLE_PREFILL_TOKEN_BUDGET=2048
MAX_LONG_PREFILLS_PER_STEP=1
GPU_MEMORY_UTILIZATION=0.90

# O14 custom runtime controls. The live wrapper imports Build A v0 directly;
# VLLM_BUILDA_VER is intentionally absent.
VLLM_ADAPTIVE_SPEC_DEPTHS=2,4,5
VLLM_MTP_INSTRUMENT=1
VLLM_MTP_INSTRUMENT_WINDOW=32
VLLM_USE_V2_MODEL_RUNNER=1
VLLM_USE_FLASHINFER_SAMPLER=1
VLLM_BUILDA_BMM=1
VLLM_MOE_MARLIN_ATOMIC_ADD=1
VLLM_MARLIN_USE_ATOMIC_ADD=1
VLLM_USE_B12X_SPARSE_INDEXER=1
VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=256
KV_FP8_ROPE=1

# Rank-container base. The serving wrapper overrides the API driver only.
CUDA_DEVICE_MAX_CONNECTIONS=4
O14_DRIVER_CUDA_DEVICE_MAX_CONNECTIONS=32

SAFETENSORS_FAST_GPU=1
CUDA_DEVICE_ORDER=PCI_BUS_ID
CUDA_MODULE_LOADING=LAZY
CUTE_DSL_ARCH=sm_121a
VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=1800
NCCL_CUMEM_ENABLE=0
NCCL_MIN_NCHANNELS=4
NCCL_MAX_NCHANNELS=4
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
VLLM_WORKER_MULTIPROC_METHOD=spawn
TORCH_NCCL_ASYNC_ERROR_HANDLING=1

# Mount an operator-selected persistent cache directory at this container path.
# The wrapper derives these subdirectories when they are not set explicitly;
# they are listed here to make the persistent layout visible.
O14_JIT_CACHE_ROOT=/var/cache/o14
CUDA_CACHE_PATH=/var/cache/o14/cuda
XDG_CACHE_HOME=/var/cache/o14/xdg
VLLM_CACHE_ROOT=/var/cache/o14/vllm
B12X_CUTE_COMPILE_CACHE_DIR=/var/cache/o14/b12x-cute
TRITON_CACHE_DIR=/var/cache/o14/triton
TORCHINDUCTOR_CACHE_DIR=/var/cache/o14/torchinductor
TORCH_EXTENSIONS_DIR=/var/cache/o14/torch-extensions

# Optional exact-head sidecar. `auto` works with stock QuantTrio, modified or
# obliterated QuantTrio, and the O14 W8-head checkpoint. It enables exact
# rescoring only when the sidecar exists under MODEL_PATH.
O14_LMHEAD_PROFILE=auto
# O14_LMHEAD_PROFILE=off
# O14_LMHEAD_PROFILE=required
# VLLM_LMHEAD_V2_SIDECAR=/models/lmhead_w8v2_sidecar.safetensors
# VLLM_LMHEAD_V2_TOPM=64

# Runtime behavior.
PYTHONUNBUFFERED=1

# Safety: render only unless explicitly changed to 1.
O14_EXECUTE=0
